# Copy to .env at the repo root, then: docker compose up --build
# The same file works for `cargo run` if you copy it to backend/.env.

# Google OAuth (Google Cloud Console -> Credentials -> OAuth 2.0 Client ID, type Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must exactly match an Authorized redirect URI registered on that client.
# Local:  http://localhost:3000/api/auth/google/callback
# Hosted: https://<your-hostname>/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Random secret, at least 32 bytes. Generate with: openssl rand -base64 48
JWT_SIGNING_SECRET=

# Caddy site address. Leave unset for local (serves http://localhost:3000).
# For the hosted demo use the bare hostname, e.g. crescend.example.com,
# and Caddy will obtain an HTTPS certificate automatically.
#SITE_ADDRESS=
